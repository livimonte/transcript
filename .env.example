# Copie para .env e preencha
ANTHROPIC_API_KEY=

# Transcrição local (faster-whisper)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto          # auto | cuda | cpu
WHISPER_COMPUTE_TYPE=auto    # auto | float16 | int8 ...
WHISPER_LANGUAGE=pt

# Refinamento com IA
REFINE_MODEL=claude-opus-5-5
REFINE_EFFORT=medium        # low | medium | high | xhigh | max

# Opcional: mover a pasta de dados dos projetos
# TRANSCRIPT_HOME=/caminho/para/projects
